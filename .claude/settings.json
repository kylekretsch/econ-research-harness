{
  "permissions": {
    "allow": [
      "Bash(pytask:*)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(duckdb:*)",
      "Bash(latexmk:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf data/raw:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect_raw.sh"
          }
        ]
      }
    ]
  }
}
